# Copy this file to .env and fill in all values before running the server.
# Values NEVER go in the repo — only in this example and the Hostinger panel.

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# ── Database (MySQL 8) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=bitlegion
DB_PASSWORD=changeme
DB_NAME=bitlegion_dev

# ── Sessions ───────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_32_plus_random_bytes

# ── Google OAuth (from Google Cloud Console) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Codeforces OIDC (from codeforces.com/settings/api) ───────────────────
CF_OIDC_CLIENT_ID=
CF_OIDC_CLIENT_SECRET=

# ── Email & superadmins ────────────────────────────────────────────────────
ALLOWED_EMAIL_SUFFIX=iiitp.ac.in
# Comma-separated emails auto-granted SUPERADMIN on first login
SEED_SUPERADMIN_EMAILS=

# ── Job tuning (defaults shown) ───────────────────────────────────────────
CF_MIN_INTERVAL_MS=2200
LEADERBOARD_BATCH_SIZE=75
SOLVED_SYNC_USERS_PER_RUN=350
SOLVED_SYNC_MAX_PAGES_PER_USER=20

# ── Optional ──────────────────────────────────────────────────────────────
# HTTP cron trigger secret (if Hostinger Cron can't run node commands directly)
JOB_TRIGGER_SECRET=
# Set by CI/deploy pipeline for the health endpoint
GIT_SHA=
