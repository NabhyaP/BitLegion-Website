{
  "name": "bitlegion",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "node server/dist/server.js",
    "migrate": "node --experimental-strip-types server/src/db/migrate.ts",
    "test": "node --test --experimental-strip-types \"server/src/**/*.test.ts\"",
    "test:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/run-integration.ps1",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
