{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "..",
    // Source imports use .ts (Node's native type stripping needs it); tsc rewrites them to .js on emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "../shared"],
  "exclude": ["src/**/*.test.ts"]
}
