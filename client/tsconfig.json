{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"],
      "@contracts": ["../shared/contracts/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
